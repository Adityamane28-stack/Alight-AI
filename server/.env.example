# ==========================================
# Full-Stack AI Chat Application Environment
# ==========================================

# Server Port
PORT=5000

# SQLite Database connection string (Prisma)
DATABASE_URL="file:./dev.db"

# JWT Secret for authenticating users
JWT_SECRET="dev-jwt-secret-key-change-in-production-12345"

# ==========================================
# AI Provider Keys (Configure at least ONE)
# ==========================================

# 1. Google Gemini API (Single key or comma-separated pool for automatic rotation)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_API_KEYS="key1,key2,key3" # Optional key pool to multiply your rate limits!

# 2. Groq API (High Speed: up to 1000 tokens/sec & 14,400 free requests/day)
# Free instant sign up at: https://console.groq.com/keys
GROQ_API_KEY=""

# 3. OpenRouter API (Access to DeepSeek R1, Llama 3.3 70B, Claude, GPT-4o)
# Free sign up at: https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# 4. OpenAI API (Optional)
OPENAI_API_KEY=""

# 5. Google OAuth 2.0 Client ID (Optional)
GOOGLE_CLIENT_ID=""
